# These values configure the PostgreSQL container.
POSTGRES_DB=platform
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform
POSTGRES_PORT=5432

# This value configures the backend and must match the PostgreSQL values above.
DATABASE_URL=postgresql+psycopg://platform:platform@127.0.0.1:5432/platform

# Integration tests require a separate database and never fall back to DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://platform:platform@127.0.0.1:5432/platform_test

# Authentication sessions are stored in PostgreSQL. Enable secure cookies under HTTPS.
AUTH_SESSION_TTL_HOURS=168
AUTH_SESSION_COOKIE_SECURE=false

# Optional: uncomment and configure all five values to enable Google authentication.
# GOOGLE_CLIENT_ID=replace-with-google-client-id
# GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
# GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
# OAUTH_STATE_SECRET=replace-with-at-least-32-random-characters
# AUTH_LOGIN_SUCCESS_REDIRECT_URL=http://127.0.0.1:5173/app
